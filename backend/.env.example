PORT=3001

# CORS (HTTP API)
# - Dev LAN (recommended): include both localhost + your LAN IP Vite URL
#   Example: CORS_ORIGIN=http://localhost:5173,http://192.168.1.50:5173
# - Prod: set to your deployed frontend URL
#   Example: CORS_ORIGIN=https://your-frontend.example
CORS_ORIGIN=http://localhost:5173,http://172.25.224.1:5173

# Supabase (use SERVICE key, not anon key)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Google Gemini API (used for AI end-of-game summary)
GOOGLE_API_KEY=your-google-ai-studio-api-key-here
# Optional: override the model name used by @google/generative-ai
GOOGLE_MODEL=gemma-3-27b-it

# OpenAI
OPENAI_API_KEY=sk-your-openai-key-here

# JWT (use same secret as Supabase JWT secret from project settings > API)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here
